{
  "name": "sunat-datos-abiertos-mcp",
  "version": "2.0.0",
  "description": "Servidor MCP y CLI para consultar los datasets abiertos de SUNAT (padron RUC, comprobantes electronicos, agentes de retencion) en streaming, sin descargar archivos de varios GB",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "test": "npm run build && node --test \"build/**/*.test.js\""
  },
  "keywords": [
    "mcp",
    "sunat",
    "peru",
    "datos-abiertos",
    "ckan",
    "ruc",
    "cli"
  ],
  "author": "andermc66",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "boxen": "^5.1.2",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "figlet": "^1.11.4",
    "ora": "^8.2.0",
    "unzipper": "^0.12.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.1.1",
    "@types/unzipper": "^0.10.11",
    "typescript": "^6.0.3"
  },
  "bin": {
    "sunat-datos-abiertos-mcp": "build/index.js",
    "sunat": "build/cli.js"
  },
  "engines": {
    "node": ">=18"
  }
}
